# App (public). Leave empty to run without accounts; patches then save to the browser only.
# `yarn setup:supabase` writes these to .env.local for you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional FretWiki AI coach (server only — never NEXT_PUBLIC).
# Leave empty to use the on-device music-theory coach.
OPENAI_API_KEY=
OPENAI_MODEL=

# Setup script only (secret, keep in .env, never in Vercel)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
